{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$room": {
        ".read":  "auth != null && root.child('members').child($room).child(auth.uid).exists()",
        ".write": "auth != null && root.child('members').child($room).child(auth.uid).exists()"
      }
    },

    "members": {
      "$room": {
        ".read": "auth != null && root.child('members').child($room).child(auth.uid).child('admin').val() == true",
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && ((auth.uid == $uid && !root.child('members').child($room).exists() && newData.child('bootstrap').val() == true) || (auth.uid == $uid && newData.child('code').exists() && root.child('invites').child(newData.child('code').val()).child('room').val() == $room && root.child('invites').child(newData.child('code').val()).child('userId').val() == newData.child('userId').val() && root.child('invites').child(newData.child('code').val()).child('exp').val() > now) || root.child('members').child($room).child(auth.uid).child('admin').val() == true)",
          ".validate": "newData.hasChildren(['userId']) && (!newData.child('admin').exists() || (newData.child('bootstrap').val() == true && !root.child('members').child($room).exists()) || (newData.child('code').exists() && root.child('invites').child(newData.child('code').val()).child('admin').val() == true))"
        }
      }
    },

    "invites": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code.length == 8 && ((newData.exists() && root.child('members').child(newData.child('room').val()).child(auth.uid).child('admin').val() == true) || (!newData.exists() && data.exists() && (root.child('members').child(data.child('room').val()).child(auth.uid).child('admin').val() == true || root.child('members').child(data.child('room').val()).child(auth.uid).child('code').val() == $code)))",
        ".validate": "newData.hasChildren(['room', 'userId', 'exp'])"
      }
    },

    "userRooms": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid && newData.child('room').exists() && root.child('members').child(newData.child('room').val()).child($uid).exists()"
      }
    }
  }
}